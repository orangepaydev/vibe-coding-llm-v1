<?xml version="1.0" encoding="utf-8" ?>
<project name="MySql" database="MySql">
  <schema name="portal">
    <table name="auth_audit_log" row_count="0">
      <comment>Audit Type: 1-Enquiry 2-Edit/Submission 3-Approval</comment>
      <column name="id" type="INT" length="11" mandatory="y">
        <identity>AUTO_INCREMENT</identity>
      </column>
      <column name="ent_org_id" type="INT" length="11">
      </column>
      <column name="remark" type="TEXT">
      </column>
      <column name="user_id" type="INT" length="11">
      </column>
      <column name="resource_id" type="INT" length="11">
      </column>
      <column name="audit_type" type="INT" length="11">
        <comment>Audit Type: 1-Enquiry 2-Edit/Submission 3-Approval</comment>
      </column>
      <column name="status_code" type="INT" length="11">
      </column>
      <column name="request_detail_id" type="INT" length="11">
      </column>
      <column name="request_url" type="VARCHAR" length="2048">
      </column>
      <column name="created_timestamp" type="TIMESTAMP" mandatory="y">
        <defo>current_timestamp()</defo>
      </column>
      <column name="created_user" type="INT" length="11">
      </column>
      <column name="user_group_id" type="INT" length="11">
        <comment>User group id as of creating audit record</comment>
      </column>
      <column name="ip_address" type="VARCHAR" length="40">
        <comment>supports either IPV4 or IPV6 ip address</comment>
      </column>
      <index name="pk_auth_audit_log" unique="PRIMARY_KEY">
        <column name="id"/>
      </index>
      <index name="fk_auth_audit_log_ent_org" unique="NORMAL">
        <column name="ent_org_id"/>
      </index>
      <index name="fk_auth_audit_log_auth_user" unique="NORMAL">
        <column name="user_id"/>
      </index>
      <index name="fk_auth_audit_log_auth_resource" unique="NORMAL">
        <column name="resource_id"/>
      </index>
      <fk name="fk_auth_audit_log_auth_resource" to_schema="portal" to_table="auth_resource" options="ON DELETE NO ACTION ON UPDATE NO ACTION">
        <fk_column name="resource_id" pk="id"/>
      </fk>
      <fk name="fk_auth_audit_log_auth_user" to_schema="portal" to_table="auth_user" options="ON DELETE NO ACTION ON UPDATE NO ACTION">
        <fk_column name="user_id" pk="id"/>
      </fk>
      <fk name="fk_auth_audit_log_ent_org" to_schema="portal" to_table="ent_org" options="ON DELETE NO ACTION ON UPDATE NO ACTION">
        <fk_column name="ent_org_id" pk="id"/>
      </fk>
    </table>
    <table name="auth_resource" row_count="2">
      <comment>Parent Module</comment>
      <column name="id" type="INT" length="11" mandatory="y">
        <identity>AUTO_INCREMENT</identity>
      </column>
      <column name="parent_module" type="VARCHAR" length="100">
        <comment>Parent Module</comment>
      </column>
      <column name="module" type="VARCHAR" length="200" mandatory="y">
      </column>
      <column name="entity_type" type="INT" length="11" mandatory="y">
        <comment>Indicate selectable entity type:
 1 - OPR
2 - SM
3 - both</comment>
      </column>
      <column name="system_type" type="INT" length="11" mandatory="y">
        <comment>Indicate system type:
 1 - Bank
2 - Opr</comment>
      </column>
      <column name="name" type="VARCHAR" length="100" mandatory="y">
      </column>
      <column name="function_name" type="VARCHAR" length="100">
        <comment>Function Name that show up in user group and profile page</comment>
      </column>
      <column name="action" type="VARCHAR" length="100">
      </column>
      <column name="remark" type="VARCHAR" length="200">
      </column>
      <column name="resource_uri" type="VARCHAR" length="100" mandatory="y">
      </column>
      <column name="resource_type" type="VARCHAR" length="20" mandatory="y">
      </column>
      <column name="audit_uri" type="VARCHAR" length="100">
        <comment>URI of audit page to display changes</comment>
      </column>
      <column name="viewable" type="INT" length="11">
        <comment>viewable in token</comment>
        <defo>0</defo>
      </column>
      <column name="optional" type="INT" length="11">
        <comment>only optional=Y allowed to configure in user group</comment>
        <defo>0</defo>
      </column>
      <column name="audit_message_template_id" type="INT" length="11">
        <comment>audit message</comment>
      </column>
      <column name="seq_no" type="INT" length="11">
        <comment>Order sequence</comment>
        <defo>0</defo>
      </column>
      <column name="rec_status" type="INT" length="11">
        <comment>status of the record
0 - Active(Approved)
1 - Pending Approval
2 - Rejected
3 - Inactive
4 - Pending Delete
5 - Delete Rejected</comment>
        <defo>1</defo>
      </column>
      <column name="maint_table_name" type="VARCHAR" length="100">
        <comment>Detail table name  for maintenance</comment>
      </column>
      <column name="resource_code" type="VARCHAR" length="20">
        <comment>code for each auth resource e.g. txn search page menu item, txn search page button</comment>
      </column>
      <index name="pk_auth_resource" unique="PRIMARY_KEY">
        <column name="id"/>
      </index>
    </table>
    <table name="auth_user" row_count="0">
      <comment>Username</comment>
      <column name="id" type="INT" length="11" mandatory="y">
        <identity>AUTO_INCREMENT</identity>
      </column>
      <column name="ent_org_id" type="INT" length="11">
      </column>
      <column name="username" type="VARCHAR" length="100" mandatory="y">
        <comment>Username</comment>
      </column>
      <column name="display_name" type="VARCHAR" length="100">
        <comment>Display name</comment>
      </column>
      <column name="created_timestamp" type="TIMESTAMP" mandatory="y">
        <defo>current_timestamp()</defo>
      </column>
      <column name="created_user" type="INT" length="11">
      </column>
      <column name="active_version" type="INT" length="11">
        <defo>0</defo>
      </column>
      <column name="session_key" type="VARCHAR" length="64">
        <comment>session key for the current user</comment>
      </column>
      <column name="user_type" type="INT">
        <comment>100  - auth0
200 - username / password</comment>
      </column>
      <index name="pk_auth_user" unique="PRIMARY_KEY">
        <column name="id"/>
      </index>
      <index name="fk_auth_user_entity_id" unique="NORMAL">
        <column name="ent_org_id"/>
      </index>
      <index name="unq_auth_user" unique="UNIQUE_KEY">
        <column name="username"/>
        <column name="user_type"/>
      </index>
      <fk name="fk_auth_user_ent_org" to_schema="portal" to_table="ent_org" options="ON DELETE NO ACTION ON UPDATE NO ACTION">
        <fk_column name="ent_org_id" pk="id"/>
      </fk>
    </table>
    <table name="auth_user_credential" row_count="0">
      <column name="id" type="INT" mandatory="y">
        <identity>AUTO_INCREMENT</identity>
      </column>
      <column name="auth_user_id" type="INT">
      </column>
      <column name="password_hash" type="VARCHAR" length="128">
      </column>
      <column name="created_timestamp" type="DATETIME">
        <defo>current_timestamp()</defo>
      </column>
      <index name="pk_auth_user_credential" unique="PRIMARY_KEY">
        <column name="id"/>
      </index>
      <fk name="fk_auth_user_credential_auth_user" to_schema="portal" to_table="auth_user">
        <fk_column name="auth_user_id" pk="id"/>
      </fk>
    </table>
    <table name="auth_user_detail" row_count="0">
      <comment>User status 0 - Active
1 - Inactive
2 - Suspended</comment>
      <column name="id" type="INT" length="11" mandatory="y">
        <identity>AUTO_INCREMENT</identity>
      </column>
      <column name="auth_user_id" type="INT" length="11" mandatory="y">
      </column>
      <column name="user_status" type="INT" length="11">
        <comment>User status 0 - Active
1 - Inactive
2 - Suspended</comment>
        <defo>0</defo>
      </column>
      <column name="email" type="VARCHAR" length="255">
        <comment>user email</comment>
      </column>
      <column name="mobile_prefix" type="VARCHAR" length="4">
      </column>
      <column name="mobile_no" type="VARCHAR" length="30">
      </column>
      <column name="created_timestamp" type="TIMESTAMP" mandatory="y">
        <defo>current_timestamp()</defo>
      </column>
      <column name="created_user" type="INT" length="11">
      </column>
      <index name="pk_auth_user_detail" unique="PRIMARY_KEY">
        <column name="id"/>
      </index>
      <index name="fk_auth_user_auth_user_id" unique="NORMAL">
        <column name="auth_user_id"/>
      </index>
      <fk name="fk_auth_user_detail_auth_user" to_schema="portal" to_table="auth_user" options="ON DELETE NO ACTION ON UPDATE NO ACTION">
        <fk_column name="auth_user_id" pk="id"/>
      </fk>
    </table>
    <table name="auth_user_group" row_count="0">
      <comment>the key for the user group matched with the auth provider</comment>
      <column name="id" type="INT" length="11" mandatory="y">
        <identity>AUTO_INCREMENT</identity>
      </column>
      <column name="user_group_code" type="VARCHAR" length="30">
        <comment>the key for the user group matched with the auth provider</comment>
      </column>
      <column name="ent_org_id" type="INT" length="11">
      </column>
      <column name="entity_type" type="INT" length="11">
        <comment>Indicate entity type, 1-OPR, 2-SM</comment>
      </column>
      <column name="is_admin" type="INT" length="11" mandatory="y">
        <comment>Indicate admin group, 0-Non-admin, 1-Admin</comment>
        <defo>0</defo>
      </column>
      <column name="is_maintainable" type="INT" length="11" mandatory="y">
        <comment>Indicate maintainable, 0-Non-maintainable, 1-Maintainable</comment>
        <defo>1</defo>
      </column>
      <column name="created_timestamp" type="TIMESTAMP" mandatory="y">
        <defo>current_timestamp()</defo>
      </column>
      <column name="created_user" type="INT" length="11">
      </column>
      <column name="active_version" type="INT" length="11">
        <defo>0</defo>
      </column>
      <index name="pk_auth_user_group" unique="PRIMARY_KEY">
        <column name="id"/>
      </index>
      <index name="fk_auth_user_group_entity_id" unique="NORMAL">
        <column name="ent_org_id"/>
      </index>
      <fk name="fk_auth_user_group_ent_org" to_schema="portal" to_table="ent_org" options="ON DELETE NO ACTION ON UPDATE NO ACTION">
        <fk_column name="ent_org_id" pk="id"/>
      </fk>
    </table>
    <table name="auth_user_group_detail" row_count="0">
      <comment>User group name</comment>
      <column name="id" type="INT" length="11" mandatory="y">
        <identity>AUTO_INCREMENT</identity>
      </column>
      <column name="user_group_id" type="INT" length="11" mandatory="y">
      </column>
      <column name="name" type="VARCHAR" length="100">
        <comment>User group name</comment>
      </column>
      <column name="remark" type="VARCHAR" length="200">
      </column>
      <column name="audit_trail_rights" type="INT" length="11">
        <comment>To indicate privilege in audit page</comment>
      </column>
      <column name="reject_reason" type="VARCHAR" length="200">
      </column>
      <column name="created_timestamp" type="TIMESTAMP" mandatory="y">
        <defo>current_timestamp()</defo>
      </column>
      <column name="created_user" type="INT" length="11">
      </column>
      <index name="pk_auth_user_group_detail" unique="PRIMARY_KEY">
        <column name="id"/>
      </index>
      <index name="fk_auth_user_group_detail_user_group_id" unique="NORMAL">
        <column name="user_group_id"/>
      </index>
      <fk name="fk_auth_user_group_detail_auth_user_group" to_schema="portal" to_table="auth_user_group" options="ON DELETE NO ACTION ON UPDATE NO ACTION">
        <fk_column name="user_group_id" pk="id"/>
      </fk>
    </table>
    <table name="auth_user_group_member" row_count="0">
      <comment>links the auth_user_detail to the user_group membership</comment>
      <column name="id" type="INT" length="11" mandatory="y">
        <identity>AUTO_INCREMENT</identity>
      </column>
      <column name="auth_user_id" type="INT" length="11">
      </column>
      <column name="auth_user_group_id" type="INT" length="11">
      </column>
      <column name="auth_user_detail_id" type="INT" length="11">
        <comment>point to the auth_user_detail record</comment>
      </column>
      <index name="pk_auth_user_group_member" unique="PRIMARY_KEY">
        <column name="id"/>
      </index>
      <index name="fk_auth_user_group_member_auth_user" unique="NORMAL">
        <column name="auth_user_id"/>
      </index>
      <index name="fk_auth_user_group_member_auth_user_group" unique="NORMAL">
        <column name="auth_user_group_id"/>
      </index>
      <index name="fk_auth_user_group_member_auth_user_detail" unique="NORMAL">
        <column name="auth_user_detail_id"/>
      </index>
      <fk name="fk_auth_user_group_member_auth_user" to_schema="portal" to_table="auth_user" options="ON DELETE NO ACTION ON UPDATE NO ACTION">
        <fk_column name="auth_user_id" pk="id"/>
      </fk>
      <fk name="fk_auth_user_group_member_auth_user_detail" to_schema="portal" to_table="auth_user_detail" options="ON DELETE NO ACTION ON UPDATE NO ACTION">
        <fk_column name="auth_user_detail_id" pk="id"/>
      </fk>
      <fk name="fk_auth_user_group_member_auth_user_group" to_schema="portal" to_table="auth_user_group" options="ON DELETE NO ACTION ON UPDATE NO ACTION">
        <fk_column name="auth_user_group_id" pk="id"/>
      </fk>
    </table>
    <table name="auth_user_group_resource" row_count="0">
      <comment>n - no permission
r - read
w - write
c - checker
a - admin</comment>
      <column name="id" type="INT" length="11" mandatory="y">
        <identity>AUTO_INCREMENT</identity>
      </column>
      <column name="user_group_id" type="INT" length="11" mandatory="y">
      </column>
      <column name="resource_id" type="INT" length="11" mandatory="y">
      </column>
      <column name="action" type="CHAR" length="1">
        <comment>n - no permission
r - read
w - write
c - checker
a - admin</comment>
      </column>
      <index name="pk_auth_user_group_resource" unique="PRIMARY_KEY">
        <column name="id"/>
      </index>
      <index name="fk_auth_user_group_resource_user_group_detail_id" unique="NORMAL">
        <column name="user_group_id"/>
      </index>
      <index name="fk_auth_user_group_resource_resource_id" unique="NORMAL">
        <column name="resource_id"/>
      </index>
      <fk name="fk_auth_user_group_resource_auth_resource" to_schema="portal" to_table="auth_resource" options="ON DELETE NO ACTION ON UPDATE NO ACTION">
        <fk_column name="resource_id" pk="id"/>
      </fk>
      <fk name="fk_auth_user_group_resource_auth_user_group_detail" to_schema="portal" to_table="auth_user_group" options="ON DELETE NO ACTION ON UPDATE NO ACTION">
        <fk_column name="user_group_id" pk="id"/>
      </fk>
    </table>
    <table name="ent_org" row_count="3">
      <comment>Participant Code</comment>
      <column name="id" type="INT" length="11" mandatory="y">
        <identity>AUTO_INCREMENT</identity>
      </column>
      <column name="org_code" type="VARCHAR" length="100">
        <comment>Participant Code</comment>
      </column>
      <column name="ent_type" type="INT" length="11">
        <comment>Indicate entity type, 

1 - Operator
2 - Participant</comment>
      </column>
      <column name="active_version" type="INT" length="11">
      </column>
      <column name="created_user" type="INT" length="11">
      </column>
      <column name="created_timestamp" type="DATETIME" mandatory="y">
        <defo>current_timestamp()</defo>
      </column>
      <index name="pk_ent_org" unique="PRIMARY_KEY">
        <column name="id"/>
      </index>
      <index name="ent_org_org_code_idx" unique="NORMAL">
        <column name="org_code"/>
      </index>
    </table>
    <table name="ent_org_detail" row_count="0">
      <column name="id" type="INT" length="11" mandatory="y">
        <identity>AUTO_INCREMENT</identity>
      </column>
      <column name="ent_org_id" type="INT" length="11" mandatory="y">
      </column>
      <column name="name" type="VARCHAR" length="100">
      </column>
      <column name="printed_name" type="VARCHAR" length="100">
      </column>
      <column name="short_code" type="VARCHAR" length="100">
      </column>
      <column name="admin_user_id_1" type="INT" length="11">
      </column>
      <column name="admin_user_id_2" type="INT" length="11">
      </column>
      <column name="created_user" type="INT" length="11">
      </column>
      <column name="created_timestamp" type="DATETIME" mandatory="y">
        <defo>current_timestamp()</defo>
      </column>
      <index name="pk_ent_org_detail" unique="PRIMARY_KEY">
        <column name="id"/>
      </index>
      <index name="fk_ent_org_detail_entity_id" unique="NORMAL">
        <column name="ent_org_id"/>
      </index>
      <fk name="fk_ent_org_detail_ent_org" to_schema="portal" to_table="ent_org" options="ON DELETE NO ACTION ON UPDATE NO ACTION">
        <fk_column name="ent_org_id" pk="id"/>
      </fk>
    </table>
    <table name="menu_component_resource_mapping" row_count="0">
      <column name="id" type="INT" length="11" mandatory="y">
        <identity>AUTO_INCREMENT</identity>
      </column>
      <column name="react_component_name" type="VARCHAR" length="100" mandatory="y">
      </column>
      <column name="resource_id" type="INT" length="11" mandatory="y">
      </column>
      <column name="path" type="VARCHAR" length="50">
      </column>
      <index name="pk_menu_component_resource_mapping" unique="PRIMARY_KEY">
        <column name="id"/>
      </index>
      <index name="fk_menu_component_resource_mapping_resource_id" unique="NORMAL">
        <column name="resource_id"/>
      </index>
      <fk name="fk_menu_component_resource_mapping_auth_resource" to_schema="portal" to_table="auth_resource" options="ON DELETE NO ACTION ON UPDATE NO ACTION">
        <fk_column name="resource_id" pk="id"/>
      </fk>
    </table>
    <table name="sys_approval_audit" row_count="0">
      <comment>the history of the approval request</comment>
      <column name="id" type="INT" length="11" mandatory="y">
        <identity>AUTO_INCREMENT</identity>
      </column>
      <column name="sys_approval_id" type="INT" length="11">
      </column>
      <column name="user_id" type="INT" length="11">
        <comment>the id of the person who trigger the action</comment>
      </column>
      <column name="action_id" type="INT" length="11">
        <comment>100 - maker created record
110 - maker cancle
1000 - check approved
1010 - check rejected
2000 - approver level 1 approved
2010 - approver level 1 rejected
3000 - approver level 2 approved
3010 - approver level 2 rejected</comment>
      </column>
      <column name="remark" type="VARCHAR" length="200">
      </column>
      <column name="created_timestamp" type="DATETIME">
        <comment>date time of the audit</comment>
        <defo>current_timestamp()</defo>
      </column>
      <index name="pk_sys_approval_audit" unique="PRIMARY_KEY">
        <column name="id"/>
      </index>
      <index name="fk_sys_approval_audit_sys_approval_request" unique="NORMAL">
        <column name="sys_approval_id"/>
      </index>
      <fk name="fk_sys_approval_audit_sys_approval_request" to_schema="portal" to_table="sys_approval_request" options="ON DELETE NO ACTION ON UPDATE NO ACTION">
        <fk_column name="sys_approval_id" pk="id"/>
      </fk>
    </table>
    <table name="sys_approval_level" row_count="0">
      <comment>10 - maker only, only maker is required to process this record
100 - checker only
200 - approval level 1, needs approval all the way up to level 1
300 - approver level 2, need approval all the way up to level 2</comment>
      <column name="id" type="INT" length="11" mandatory="y">
        <identity>AUTO_INCREMENT</identity>
      </column>
      <column name="required_level" type="INT" length="11">
        <comment>10 - maker only, only maker is required to process this record
100 - checker only
200 - approval level 1, needs approval all the way up to level 1
300 - approver level 2, need approval all the way up to level 2</comment>
        <defo>200</defo>
      </column>
      <column name="ent_org_id" type="INT" length="11">
      </column>
      <column name="resource_id" type="INT" length="11">
        <comment>0 - common for all resources
100 - ent_org</comment>
      </column>
      <column name="created_user" type="INT" length="11">
      </column>
      <column name="created_timestamp" type="DATETIME">
        <defo>current_timestamp()</defo>
      </column>
      <column name="modified_user" type="INT" length="11">
      </column>
      <column name="modified_timestamp" type="DATETIME">
      </column>
      <index name="pk_sys_approval_level" unique="PRIMARY_KEY">
        <column name="id"/>
      </index>
    </table>
    <table name="sys_approval_matrix" row_count="0">
      <comment>contains a relationshiop of  the maker, checker and approver for each resources</comment>
      <column name="id" type="INT" length="11" mandatory="y">
        <identity>AUTO_INCREMENT</identity>
      </column>
      <column name="ent_org_id" type="INT" length="11">
      </column>
      <column name="user_group_id" type="INT" length="11">
        <comment>the user group that could perform this action</comment>
      </column>
      <column name="resource_id" type="INT" length="11">
        <comment>0 - common for all resources
100 - ent_org</comment>
      </column>
      <column name="role" type="INT" length="11">
        <comment>100 - maker only
200 - checker only
300 - maker and checker
400 - approver level 1
500 - approver level 2</comment>
      </column>
      <index name="pk_sys_approval_matrix" unique="PRIMARY_KEY">
        <column name="id"/>
      </index>
      <index name="fk_sys_approval_matrix_comp" unique="NORMAL">
        <column name="ent_org_id"/>
      </index>
      <index name="fk_sys_approval_matrix" unique="NORMAL">
        <column name="user_group_id"/>
      </index>
      <fk name="fk_sys_approval_matrix" to_schema="portal" to_table="auth_user_group" options="ON DELETE NO ACTION ON UPDATE NO ACTION">
        <fk_column name="user_group_id" pk="id"/>
      </fk>
      <fk name="fk_sys_approval_matrix_comp" to_schema="portal" to_table="ent_org" options="ON DELETE NO ACTION ON UPDATE NO ACTION">
        <fk_column name="ent_org_id" pk="id"/>
      </fk>
    </table>
    <table name="sys_approval_request" row_count="0">
      <comment>Store all the request that needs approval</comment>
      <column name="id" type="INT" length="11" mandatory="y">
        <identity>AUTO_INCREMENT</identity>
      </column>
      <column name="maker_user" type="INT" length="11">
        <comment>the user who is requesting this approval</comment>
      </column>
      <column name="maker_timestamp" type="DATETIME">
        <defo>CURRENT_TIMESTAMP</defo>
      </column>
      <column name="request_status" type="INT" length="11">
        <comment>110 - maker cancel
200 - pending Checker
210 - rejected by Checker
400 - pending approver level 1
410 - rejected by approver level 1
500 - pending approver level 2
510 - rejected by approver level 2
600 - approved</comment>
        <defo>100</defo>
      </column>
      <column name="reference_type" type="INT">
        <comment>100 - sys_param</comment>
      </column>
      <column name="reference_id" type="INT" length="11">
        <comment>depending on reference_type</comment>
      </column>
      <column name="reference_id_version" type="INT">
        <comment>the version that needs to be activated</comment>
      </column>
      <column name="approval_status" type="INT" length="11">
        <comment>1 - active, pending approval
2 - approved
3 - cancel / rejected</comment>
        <defo>1</defo>
      </column>
      <index name="pk_sys_approval_request" unique="PRIMARY_KEY">
        <column name="id"/>
      </index>
      <index name="fk_sys_approval_request_auth_user" unique="NORMAL">
        <column name="maker_user"/>
      </index>
      <fk name="fk_sys_approval_request_auth_user" to_schema="portal" to_table="auth_user" options="ON DELETE NO ACTION ON UPDATE NO ACTION">
        <fk_column name="maker_user" pk="id"/>
      </fk>
    </table>
    <table name="sys_param" row_count="0">
      <comment>System Parameter</comment>
      <column name="id" type="INT" length="11" mandatory="y">
        <identity>AUTO_INCREMENT</identity>
      </column>
      <column name="param_category" type="INT" length="11" mandatory="y">
        <comment>Indicate parameter category
1 - Group 1 - User defined  Parameters for Payout 
2 - Group 2 -  System Parameters  for Processing</comment>
      </column>
      <column name="param_code" type="VARCHAR" length="100">
        <comment>Parameter code</comment>
      </column>
      <column name="param_type" type="VARCHAR" length="100" mandatory="y">
      </column>
      <column name="created_timestamp" type="TIMESTAMP" mandatory="y">
        <defo>current_timestamp()</defo>
      </column>
      <column name="created_user" type="INT" length="11">
      </column>
      <column name="active_version" type="INT" length="11">
        <defo>0</defo>
      </column>
      <index name="pk_sys_param" unique="PRIMARY_KEY">
        <column name="id"/>
      </index>
    </table>
    <table name="sys_param_detail" row_count="0">
      <comment>Parameter description</comment>
      <column name="id" type="INT" length="11" mandatory="y">
        <identity>AUTO_INCREMENT</identity>
      </column>
      <column name="param_id" type="INT" length="11" mandatory="y">
      </column>
      <column name="param_description" type="VARCHAR" length="200">
        <comment>Parameter description</comment>
      </column>
      <column name="remark" type="VARCHAR" length="200">
      </column>
      <column name="created_timestamp" type="TIMESTAMP" mandatory="y">
        <defo>current_timestamp()</defo>
      </column>
      <column name="created_user" type="INT" length="11">
      </column>
      <column name="param_value" type="VARCHAR" length="100">
      </column>
      <column name="status" type="INT">
        <comment>Record
0 - Active
1 - Inactive</comment>
        <defo>0</defo>
      </column>
      <index name="pk_sys_param_detail" unique="PRIMARY_KEY">
        <column name="id"/>
      </index>
      <index name="fk_system_parameter_detail_param_id" unique="NORMAL">
        <column name="param_id"/>
      </index>
      <fk name="fk_sys_param_detail_sys_param" to_schema="portal" to_table="sys_param" options="ON DELETE NO ACTION ON UPDATE NO ACTION">
        <fk_column name="param_id" pk="id"/>
      </fk>
    </table>
