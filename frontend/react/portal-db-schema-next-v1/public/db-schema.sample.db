				<comment><![CDATA[Username]]></comment>
			</column>
			<column name="display_name" type="VARCHAR" length="100" jt="12" >
				<comment><![CDATA[Display name]]></comment>
			</column>
			<column name="created_timestamp" type="TIMESTAMP" jt="93" mandatory="y" >
				<defo><![CDATA[current_timestamp()]]></defo>
			</column>
			<column name="created_user" type="INT" length="11" jt="4" />
			<column name="active_version" type="INT" length="11" jt="4" >
				<defo><![CDATA[0]]></defo>
			</column>
			<column name="session_key" type="VARCHAR" length="64" jt="12" >
				<comment><![CDATA[session key for the current user]]></comment>
			</column>
			<column name="user_type" type="INT" jt="4" >
				<comment><![CDATA[100  - auth0
200 - username / password]]></comment>
			</column>
			<index name="pk_auth_user" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
			<index name="fk_auth_user_entity_id" unique="NORMAL" >
				<column name="ent_org_id" />
			</index>
			<index name="unq_auth_user" unique="UNIQUE_KEY" >
				<column name="username" />
				<column name="user_type" />
			</index>
			<fk name="fk_auth_user_ent_org" to_schema="portal" to_table="ent_org" options="ON DELETE NO ACTION ON UPDATE NO ACTION" >
				<fk_column name="ent_org_id" pk="id" />
			</fk>
			<options><![CDATA[ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_uca1400_ai_ci]]></options>
		</table>
