<?xml version="1.0" encoding="UTF-8" ?>
<project name="MySql" database="MySql" id="Project-da" >
	<schema name="portal" >
		<table name="auth_audit_log" row_count="0" spec="" >
			<column name="id" type="INT" length="11" jt="4" mandatory="y" >
				<identity><![CDATA[AUTO_INCREMENT]]></identity>
			</column>
			<column name="ent_org_id" type="INT" length="11" jt="4" />
			<column name="remark" type="TEXT" jt="-1" />
			<column name="user_id" type="INT" length="11" jt="4" />
			<column name="resource_id" type="INT" length="11" jt="4" />
			<column name="audit_type" type="INT" length="11" jt="4" >
				<comment><![CDATA[Audit Type: 1-Enquiry 2-Edit/Submission 3-Approval]]></comment>
			</column>
			<column name="status_code" type="INT" length="11" jt="4" />
			<column name="request_detail_id" type="INT" length="11" jt="4" />
			<column name="request_url" type="VARCHAR" length="2048" jt="12" />
			<column name="created_timestamp" type="TIMESTAMP" jt="93" mandatory="y" >
				<defo><![CDATA[current_timestamp()]]></defo>
			</column>
			<column name="created_user" type="INT" length="11" jt="4" />
			<column name="user_group_id" type="INT" length="11" jt="4" >
				<comment><![CDATA[User group id as of creating audit record]]></comment>
			</column>
			<column name="ip_address" type="VARCHAR" length="40" jt="12" >
				<comment><![CDATA[supports either IPV4 or IPV6 ip address]]></comment>
			</column>
			<index name="pk_auth_audit_log" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
			<index name="fk_auth_audit_log_ent_org" unique="NORMAL" >
				<column name="ent_org_id" />
			</index>
			<index name="fk_auth_audit_log_auth_user" unique="NORMAL" >
				<column name="user_id" />
			</index>
			<index name="fk_auth_audit_log_auth_resource" unique="NORMAL" >
				<column name="resource_id" />
			</index>
			<fk name="fk_auth_audit_log_auth_resource" to_schema="portal" to_table="auth_resource" options="ON DELETE NO ACTION ON UPDATE NO ACTION" >
				<fk_column name="resource_id" pk="id" />
			</fk>
			<fk name="fk_auth_audit_log_auth_user" to_schema="portal" to_table="auth_user" options="ON DELETE NO ACTION ON UPDATE NO ACTION" >
				<fk_column name="user_id" pk="id" />
			</fk>
			<fk name="fk_auth_audit_log_ent_org" to_schema="portal" to_table="ent_org" options="ON DELETE NO ACTION ON UPDATE NO ACTION" >
				<fk_column name="ent_org_id" pk="id" />
			</fk>
			<options><![CDATA[ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_uca1400_ai_ci]]></options>
		</table>
		<table name="auth_resource" row_count="2" spec="" >
			<column name="id" type="INT" length="11" jt="4" mandatory="y" >
				<identity><![CDATA[AUTO_INCREMENT]]></identity>
			</column>
			<column name="parent_module" type="VARCHAR" length="100" jt="12" >
				<comment><![CDATA[Parent Module]]></comment>
			</column>
			<column name="module" type="VARCHAR" length="200" jt="12" mandatory="y" />
			<column name="entity_type" type="INT" length="11" jt="4" mandatory="y" >
				<comment><![CDATA[Indicate selectable entity type:
 1 - OPR
2 - SM
3 - both]]></comment>
			</column>
			<column name="system_type" type="INT" length="11" jt="4" mandatory="y" >
				<comment><![CDATA[Indicate system type:
 1 - Bank
2 - Opr]]></comment>
			</column>
			<column name="name" type="VARCHAR" length="100" jt="12" mandatory="y" />
			<column name="function_name" type="VARCHAR" length="100" jt="12" >
				<comment><![CDATA[Function Name that show up in user group and profile page]]></comment>
			</column>
			<column name="action" type="VARCHAR" length="100" jt="12" />
			<column name="remark" type="VARCHAR" length="200" jt="12" />
			<column name="resource_uri" type="VARCHAR" length="100" jt="12" mandatory="y" />
			<column name="resource_type" type="VARCHAR" length="20" jt="12" mandatory="y" />
			<column name="audit_uri" type="VARCHAR" length="100" jt="12" >
				<comment><![CDATA[URI of audit page to display changes]]></comment>
			</column>
			<column name="viewable" type="INT" length="11" jt="4" >
				<defo><![CDATA[0]]></defo>
				<comment><![CDATA[viewable in token]]></comment>
			</column>
			<column name="optional" type="INT" length="11" jt="4" >
				<defo><![CDATA[0]]></defo>
				<comment><![CDATA[only optional=Y allowed to configure in user group]]></comment>
			</column>
			<column name="audit_message_template_id" type="INT" length="11" jt="4" >
				<comment><![CDATA[audit message]]></comment>
			</column>
			<column name="seq_no" type="INT" length="11" jt="4" >
				<defo><![CDATA[0]]></defo>
				<comment><![CDATA[Order sequence]]></comment>
			</column>
			<column name="rec_status" type="INT" length="11" jt="4" >
				<defo><![CDATA[1]]></defo>
				<comment><![CDATA[status of the record
0 - Active(Approved)
1 - Pending Approval
2 - Rejected
3 - Inactive
4 - Pending Delete
5 - Delete Rejected]]></comment>
			</column>
			<column name="maint_table_name" type="VARCHAR" length="100" jt="12" >
				<comment><![CDATA[Detail table name  for maintenance]]></comment>
			</column>
			<column name="resource_code" type="VARCHAR" length="20" jt="12" >
				<comment><![CDATA[code for each auth resource e.g. txn search page menu item, txn search page button]]></comment>
			</column>
			<index name="pk_auth_resource" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
			<options><![CDATA[ENGINE=InnoDB ]]></options>
		</table>
		<table name="auth_user" row_count="0" spec="" >
			<column name="id" type="INT" length="11" jt="4" mandatory="y" >
				<identity><![CDATA[AUTO_INCREMENT]]></identity>
			</column>
			<column name="ent_org_id" type="INT" length="11" jt="4" />
