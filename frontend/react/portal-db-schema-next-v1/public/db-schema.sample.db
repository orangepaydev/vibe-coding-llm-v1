		<table name="sys_approval_audit" row_count="0" spec="" >
			<comment><![CDATA[the history of the approval request]]></comment>
			<column name="id" type="INT" length="11" jt="4" mandatory="y" >
				<identity><![CDATA[AUTO_INCREMENT]]></identity>
			</column>
			<column name="sys_approval_id" type="INT" length="11" jt="4" />
			<column name="user_id" type="INT" length="11" jt="4" >
				<comment><![CDATA[the id of the person who trigger the action]]></comment>
			</column>
			<column name="action_id" type="INT" length="11" jt="4" >
				<comment><![CDATA[100 - maker created record
110 - maker cancle
1000 - check approved
1010 - check rejected
2000 - approver level 1 approved
2010 - approver level 1 rejected
3000 - approver level 2 approved
3010 - approver level 2 rejected]]></comment>
			</column>
			<column name="remark" type="VARCHAR" length="200" jt="12" />
			<column name="created_timestamp" prior="created_dt" type="DATETIME" jt="93" >
				<defo><![CDATA[current_timestamp()]]></defo>
				<comment><![CDATA[date time of the audit]]></comment>
			</column>
			<index name="pk_sys_approval_audit" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
			<index name="fk_sys_approval_audit_sys_approval_request" unique="NORMAL" >
				<column name="sys_approval_id" />
			</index>
			<fk name="fk_sys_approval_audit_sys_approval_request" to_schema="portal" to_table="sys_approval_request" options="ON DELETE NO ACTION ON UPDATE NO ACTION" >
				<fk_column name="sys_approval_id" pk="id" />
			</fk>
			<options><![CDATA[ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_uca1400_ai_ci]]></options>
		</table>
		<table name="sys_approval_level" row_count="0" spec="" >
			<column name="id" type="INT" length="11" jt="4" mandatory="y" >
				<identity><![CDATA[AUTO_INCREMENT]]></identity>
			</column>
			<column name="required_level" type="INT" length="11" jt="4" >
				<defo><![CDATA[200]]></defo>
				<comment><![CDATA[10 - maker only, only maker is required to process this record
100 - checker only
200 - approval level 1, needs approval all the way up to level 1
300 - approver level 2, need approval all the way up to level 2]]></comment>
			</column>
			<column name="ent_org_id" type="INT" length="11" jt="4" />
			<column name="resource_id" type="INT" length="11" jt="4" >
				<comment><![CDATA[0 - common for all resources
100 - ent_org]]></comment>
			</column>
			<column name="created_user" prior="created_user_id" type="INT" length="11" jt="4" />
			<column name="created_timestamp" prior="created_dt" type="DATETIME" jt="93" >
				<defo><![CDATA[current_timestamp()]]></defo>
			</column>
			<column name="modified_user" prior="modified_user_id" type="INT" length="11" jt="4" />
			<column name="modified_timestamp" prior="modified_dt" type="DATETIME" jt="93" >
				<column_options><![CDATA[ON UPDATE CURRENT_TIMESTAMP]]></column_options>
			</column>
			<index name="pk_sys_approval_level" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
			<options><![CDATA[ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_uca1400_ai_ci]]></options>
		</table>
		<table name="sys_approval_matrix" row_count="0" spec="" >
			<comment><![CDATA[contains a relationshiop of  the maker, checker and approver for each resources]]></comment>
			<column name="id" type="INT" length="11" jt="4" mandatory="y" >
				<identity><![CDATA[AUTO_INCREMENT]]></identity>
			</column>
			<column name="ent_org_id" type="INT" length="11" jt="4" />
			<column name="user_group_id" type="INT" length="11" jt="4" >
				<comment><![CDATA[the user group that could perform this action]]></comment>
			</column>
			<column name="resource_id" type="INT" length="11" jt="4" >
				<comment><![CDATA[0 - common for all resources
100 - ent_org]]></comment>
			</column>
			<column name="role" type="INT" length="11" jt="4" >
				<comment><![CDATA[100 - maker only
200 - checker only
300 - maker and checker
400 - approver level 1
500 - approver level 2]]></comment>
			</column>
			<index name="pk_sys_approval_matrix" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
			<index name="fk_sys_approval_matrix_comp" unique="NORMAL" >
				<column name="ent_org_id" />
			</index>
			<index name="fk_sys_approval_matrix" unique="NORMAL" >
				<column name="user_group_id" />
			</index>
			<fk name="fk_sys_approval_matrix" to_schema="portal" to_table="auth_user_group" options="ON DELETE NO ACTION ON UPDATE NO ACTION" >
				<fk_column name="user_group_id" pk="id" />
			</fk>
			<fk name="fk_sys_approval_matrix_comp" to_schema="portal" to_table="ent_org" options="ON DELETE NO ACTION ON UPDATE NO ACTION" >
				<fk_column name="ent_org_id" pk="id" />
			</fk>
			<options><![CDATA[ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_uca1400_ai_ci]]></options>
		</table>
		<table name="sys_approval_request" row_count="0" spec="" >
			<comment><![CDATA[Store all the request that needs approval]]></comment>
			<column name="id" type="INT" length="11" jt="4" mandatory="y" >
				<identity><![CDATA[AUTO_INCREMENT]]></identity>
			</column>
			<column name="maker_user" prior="maker_user_id" type="INT" length="11" jt="4" >
				<comment><![CDATA[the user who is requesting this approval]]></comment>
			</column>
			<column name="maker_timestamp" prior="maker_dt" type="DATETIME" jt="93" >
				<defo><![CDATA[CURRENT_TIMESTAMP]]></defo>
			</column>
			<column name="request_status" type="INT" length="11" jt="4" >
				<defo><![CDATA[100]]></defo>
				<comment><![CDATA[110 - maker cancel
200 - pending Checker
210 - rejected by Checker
400 - pending approver level 1
410 - rejected by approver level 1
500 - pending approver level 2
510 - rejected by approver level 2
600 - approved]]></comment>
			</column>
			<column name="reference_type" type="INT" jt="4" >
				<comment><![CDATA[100 - sys_param]]></comment>
			</column>
			<column name="reference_id" type="INT" length="11" jt="4" >
				<comment><![CDATA[depending on reference_type]]></comment>
			</column>
			<column name="reference_id_version" type="INT" jt="4" >
				<comment><![CDATA[the version that needs to be activated]]></comment>
			</column>
			<column name="approval_status" type="INT" length="11" jt="4" >
				<defo><![CDATA[1]]></defo>
				<comment><![CDATA[1 - active, pending approval
2 - approved
3 - cancel / rejected]]></comment>
			</column>
			<index name="pk_sys_approval_request" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
			<index name="fk_sys_approval_request_auth_user" unique="NORMAL" >
				<column name="maker_user" />
			</index>
			<fk name="fk_sys_approval_request_auth_user" to_schema="portal" to_table="auth_user" options="ON DELETE NO ACTION ON UPDATE NO ACTION" >
				<fk_column name="maker_user" pk="id" />
			</fk>
			<options><![CDATA[ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_uca1400_ai_ci]]></options>
		</table>
		<table name="sys_param" row_count="0" spec="" >
			<comment><![CDATA[System Parameter]]></comment>
			<column name="id" type="INT" length="11" jt="4" mandatory="y" >
				<identity><![CDATA[AUTO_INCREMENT]]></identity>
			</column>
			<column name="param_category" type="INT" length="11" jt="4" mandatory="y" >
				<comment><![CDATA[Indicate parameter category
1 - Group 1 - User defined  Parameters for Payout 
2 - Group 2 -  System Parameters  for Processing]]></comment>
			</column>
			<column name="param_code" type="VARCHAR" length="100" jt="12" >
				<comment><![CDATA[Parameter code]]></comment>
			</column>
			<column name="param_type" type="VARCHAR" length="100" jt="12" mandatory="y" />
			<column name="created_timestamp" type="TIMESTAMP" jt="93" mandatory="y" >
				<defo><![CDATA[current_timestamp()]]></defo>
			</column>
			<column name="created_user" type="INT" length="11" jt="4" />
			<column name="active_version" type="INT" length="11" jt="4" >
				<defo><![CDATA[0]]></defo>
			</column>
			<index name="pk_sys_param" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
			<options><![CDATA[ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_uca1400_ai_ci]]></options>
		</table>
		<table name="sys_param_detail" row_count="0" spec="" >
			<column name="id" type="INT" length="11" jt="4" mandatory="y" >
				<identity><![CDATA[AUTO_INCREMENT]]></identity>
			</column>
			<column name="param_id" type="INT" length="11" jt="4" mandatory="y" />
			<column name="param_description" type="VARCHAR" length="200" jt="12" >
				<comment><![CDATA[Parameter description]]></comment>
			</column>
			<column name="remark" type="VARCHAR" length="200" jt="12" />
			<column name="created_timestamp" type="TIMESTAMP" jt="93" mandatory="y" >
				<defo><![CDATA[current_timestamp()]]></defo>
			</column>
			<column name="created_user" type="INT" length="11" jt="4" />
			<column name="param_value" prior="pram_value" type="VARCHAR" length="100" jt="12" />
			<column name="status" type="INT" jt="4" >
				<defo><![CDATA[0]]></defo>
				<comment><![CDATA[Record
0 - Active
1 - Inactive]]></comment>
			</column>
			<index name="pk_sys_param_detail" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
			<index name="fk_system_parameter_detail_param_id" unique="NORMAL" >
				<column name="param_id" />
			</index>
			<fk name="fk_sys_param_detail_sys_param" to_schema="portal" to_table="sys_param" options="ON DELETE NO ACTION ON UPDATE NO ACTION" >
				<fk_column name="param_id" pk="id" />
			</fk>
			<options><![CDATA[ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_uca1400_ai_ci]]></options>
		</table>
	</schema>
